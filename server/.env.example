# Shared secret. Put the same value in the app: Settings → שרת עיבוד → מפתח גישה.
# Generate one with: openssl rand -hex 24
APP_TOKEN=

# Claude names and categorizes songs (console.anthropic.com).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Hebrew transcription. Defaults to OpenAI. To use a self-hosted Whisper server
# (for example an ivrit.ai Hebrew model behind an OpenAI-compatible API), set the base URL.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_BASE_URL=

PORT=8787
MAX_UPLOAD_MB=40
FILE_TTL_MINUTES=30
