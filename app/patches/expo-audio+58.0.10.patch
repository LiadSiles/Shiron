+  // [shiron] A foreground service's notification can't be swiped away. Like media3's own
+  // MediaSessionService, stay in the foreground only while playback is meant to run; when paused
+  // or finished, detach so the notification becomes dismissible, and re-promote on resume.
+  private var detached = false
+  private var dismissed = false
+
+  private fun updateForegroundState() {
+    val player = currentPlayable?.player ?: return
+    val running = player.playWhenReady &&
+      player.playbackState != Player.STATE_ENDED &&
+      player.playbackState != Player.STATE_IDLE
+    if (running && (detached || dismissed)) {
+      detached = false
+      dismissed = false
+      postOrStartForegroundNotification(startInForeground = true)
+    } else if (!running && !detached) {
+      detached = true
+      stopForeground(STOP_FOREGROUND_DETACH)
+      postOrStartForegroundNotification(startInForeground = false)
+    }
+  }
+
+  // [shiron] Closing the app from recents while nothing plays removes the controls entirely.
+  override fun onTaskRemoved(rootIntent: Intent?) {
+    val player = currentPlayable?.player
