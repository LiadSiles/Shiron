{
  "expo": {
    "name": "פלייגן",
    "slug": "shiron",
    "scheme": "shiron",
    "version": "0.14.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF7F1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shiron.gan",
      "infoPlist": {
        "CFBundleDisplayName": "PlayGan",
        "CFBundleDevelopmentRegion": "he",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "app.shiron.gan",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-font",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 100,
            "NSExtensionActivationSupportsMovieWithMaxCount": 100,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "PlayGan",
          "androidIntentFilters": [
            "text/*",
            "audio/*",
            "video/*",
            "application/ogg",
            "application/octet-stream"
          ],
          "androidMultiIntentFilters": [
            "audio/*",
            "video/*",
            "application/ogg"
          ]
        }
      ],
      "./plugins/withSigningKey",
      "./plugins/withKeepRules",
      "./plugins/withDisplayName",
      "expo-secure-store",
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#16151A",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
