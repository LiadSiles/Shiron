{
  "name": "shiron-repo",
  "private": true,
  "description": "Shiron — a song library for kindergarten teachers (Expo app, iOS + Android).",
  "scripts": {
    "install:all": "npm ci --prefix app",
    "test": "npm test --prefix app",
    "typecheck": "npm run typecheck --prefix app",
    "check": "npm run typecheck && npm test",
    "test:ios-audio": "bash app/modules/shiron-audio/swift-tests/run.sh",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
